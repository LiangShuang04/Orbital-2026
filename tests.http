@baseUrl = http://127.0.0.1:5000/api/v1
@username = orbital_test_player
@email = orbital.test.player@example.com
@password = StrongPassword123
@token = {{login.response.body.$.token}}

# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "{{username}}",
  "email": "{{email}}",
  "password": "{{password}}"
}

###

# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

# @name createSave
POST {{baseUrl}}/save
Authorization: Bearer {{token}}
Content-Type: application/json

{}

###

# @name getSave
GET {{baseUrl}}/save
Authorization: Bearer {{token}}
